{
  "openapi": "3.0.0",
  "info": {
    "title": "Calendar API",
    "version": "1.0.0",
    "description": "Technical API for the Calendar application."
  },
  "tags": [
    {
      "name": "Health"
    },
    {
      "name": "Meeting types"
    },
    {
      "name": "Administrator authentication"
    },
    {
      "name": "Administrator meeting types"
    }
  ],
  "paths": {
    "/admin/meeting-types": {
      "get": {
        "operationId": "listAdminMeetingTypes",
        "summary": "List all meeting types",
        "description": "Requires administrator access. Includes hidden drafts and publication state; responses are not cacheable.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminMeetingTypeList"
                }
              }
            }
          },
          "401": {
            "description": "No valid administrator session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          }
        },
        "tags": [
          "Administrator meeting types"
        ],
        "security": [
          {
            "AdminCookie": []
          }
        ]
      },
      "post": {
        "operationId": "createAdminMeetingType",
        "summary": "Create a hidden meeting type",
        "description": "Save never publishes. Requires same-origin protection. Invalid input or an occupied address returns field errors without saving or renaming.",
        "parameters": [
          {
            "name": "X-Calendar-Request",
            "in": "header",
            "required": true,
            "description": "Required mutation protection header.",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          }
        ],
        "responses": {
          "201": {
            "description": "The request has succeeded and a new resource has been created as a result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminMeetingType"
                }
              }
            }
          },
          "401": {
            "description": "No valid administrator session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "403": {
            "description": "The browser request failed same-origin protection.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "422": {
            "description": "The offer was not saved; preserve the form and correct these fields.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "description": "Safe English summary.",
                      "example": "Please correct the highlighted fields."
                    },
                    "errors": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/MeetingTypeFieldErrors"
                        }
                      ],
                      "description": "Errors beside the relevant fields.",
                      "example": {
                        "slug": [
                          "has already been taken"
                        ]
                      }
                    }
                  },
                  "required": [
                    "message",
                    "errors"
                  ],
                  "additionalProperties": {
                    "not": {}
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Administrator meeting types"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewMeetingType"
              }
            }
          },
          "description": "The administrator's explicit offer details."
        },
        "security": [
          {
            "AdminCookie": []
          }
        ]
      }
    },
    "/admin/meeting-types/{id}": {
      "get": {
        "operationId": "getAdminMeetingType",
        "summary": "Read meeting type details for editing",
        "description": "Requires administrator access; hidden offers are included. Responses are not cacheable.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Immutable system-assigned identifier.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminMeetingType"
                }
              }
            }
          },
          "401": {
            "description": "No valid administrator session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "404": {
            "description": "The administrative meeting type does not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          }
        },
        "tags": [
          "Administrator meeting types"
        ],
        "security": [
          {
            "AdminCookie": []
          }
        ]
      },
      "put": {
        "operationId": "updateAdminMeetingType",
        "summary": "Save meeting type details without changing publication",
        "description": "Uses creation validation. Identity is immutable. A changed address immediately releases the old address without redirecting it. Existing booking snapshots and occupancy are unchanged.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Immutable system-assigned identifier.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Calendar-Request",
            "in": "header",
            "required": true,
            "description": "Required mutation protection header.",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminMeetingType"
                }
              }
            }
          },
          "401": {
            "description": "No valid administrator session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "403": {
            "description": "The browser request failed same-origin protection.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "404": {
            "description": "The administrative meeting type does not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "422": {
            "description": "The offer was not saved; preserve the form and correct these fields.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "description": "Safe English summary.",
                      "example": "Please correct the highlighted fields."
                    },
                    "errors": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/MeetingTypeFieldErrors"
                        }
                      ],
                      "description": "Errors beside the relevant fields.",
                      "example": {
                        "slug": [
                          "has already been taken"
                        ]
                      }
                    }
                  },
                  "required": [
                    "message",
                    "errors"
                  ],
                  "additionalProperties": {
                    "not": {}
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Administrator meeting types"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewMeetingType"
              }
            }
          },
          "description": "Complete editable details; omitted description is empty."
        },
        "security": [
          {
            "AdminCookie": []
          }
        ]
      }
    },
    "/admin/meeting-types/{id}/publication": {
      "put": {
        "operationId": "setAdminMeetingTypePublication",
        "summary": "Publish, hide or republish a meeting type",
        "description": "Explicit idempotent state change, separate from Save. Hiding prevents new bookings but preserves existing snapshots and occupancy. Only successful responses confirm the new state.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Immutable system-assigned identifier.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Calendar-Request",
            "in": "header",
            "required": true,
            "description": "Required mutation protection header.",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminMeetingType"
                }
              }
            }
          },
          "401": {
            "description": "No valid administrator session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "403": {
            "description": "The browser request failed same-origin protection.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "404": {
            "description": "The administrative meeting type does not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "422": {
            "description": "The offer was not saved; preserve the form and correct these fields.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "description": "Safe English summary.",
                      "example": "Please correct the highlighted fields."
                    },
                    "errors": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/MeetingTypeFieldErrors"
                        }
                      ],
                      "description": "Errors beside the relevant fields.",
                      "example": {
                        "slug": [
                          "has already been taken"
                        ]
                      }
                    }
                  },
                  "required": [
                    "message",
                    "errors"
                  ],
                  "additionalProperties": {
                    "not": {}
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Administrator meeting types"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MeetingTypePublication"
              }
            }
          },
          "description": "Explicit desired state."
        },
        "security": [
          {
            "AdminCookie": []
          }
        ]
      }
    },
    "/admin/session": {
      "post": {
        "operationId": "loginAdmin",
        "summary": "Log in to the single administrator account",
        "description": "Creates a 24-hour session. Requires X-Calendar-Request: 1 and same-origin browser requests. Sets an HttpOnly cookie. Credentials errors are always generic. Ten attempts per IP per 15 minutes, shared through PostgreSQL.",
        "parameters": [
          {
            "name": "X-Calendar-Request",
            "in": "header",
            "required": true,
            "description": "Required custom header; cross-origin browsers must preflight and are not granted CORS access.",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminSession"
                }
              }
            }
          },
          "401": {
            "description": "No valid administrator session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "403": {
            "description": "The browser request failed same-origin protection.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "429": {
            "description": "Ten login attempts per IP per 15-minute window have been used.",
            "headers": {
              "Retry-After": {
                "required": true,
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          }
        },
        "tags": [
          "Administrator authentication"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "description": "The operator-configured username and password."
        }
      },
      "get": {
        "operationId": "getAdminSession",
        "summary": "Read the current administrator session",
        "description": "Requires the session cookie; never extends expiry. Responses are not cacheable.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminSession"
                }
              }
            }
          },
          "401": {
            "description": "No valid administrator session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          }
        },
        "tags": [
          "Administrator authentication"
        ],
        "security": [
          {
            "AdminCookie": []
          }
        ]
      },
      "delete": {
        "operationId": "logoutAdmin",
        "summary": "Revoke the current administrator session",
        "description": "Immediately revokes the cookie's session. Requires X-Calendar-Request: 1; safe to repeat.",
        "parameters": [
          {
            "name": "X-Calendar-Request",
            "in": "header",
            "required": true,
            "description": "Required custom header protecting against cross-origin form submissions.",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          }
        ],
        "responses": {
          "204": {
            "description": "There is no content to send for this request, but the headers may be useful. "
          },
          "403": {
            "description": "The browser request failed same-origin protection.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          }
        },
        "tags": [
          "Administrator authentication"
        ],
        "security": [
          {
            "AdminCookie": []
          }
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Get API health",
        "description": "Check API process health independently of database readiness.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        },
        "tags": [
          "Health"
        ]
      }
    },
    "/meeting-types": {
      "get": {
        "operationId": "listMeetingTypes",
        "summary": "List published meeting types",
        "description": "Return every published offer. Hidden offers are never included.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeetingTypeList"
                }
              }
            }
          }
        },
        "tags": [
          "Meeting types"
        ]
      }
    },
    "/meeting-types/{slug}/availability": {
      "get": {
        "operationId": "getAvailability",
        "summary": "Get a public meeting calendar",
        "description": "Return fourteen Berlin dates with advisory shared availability. Reading never creates a booking or reserves an interval.",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "description": "Current public address segment.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Availability"
                }
              }
            }
          },
          "404": {
            "description": "The server cannot find the requested resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeetingTypeUnavailable"
                }
              }
            }
          }
        },
        "tags": [
          "Meeting types"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AdminMeetingType": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "durationMinutes",
          "slug",
          "published"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Immutable system-assigned identifier.",
            "example": "29a71c26-c842-407d-bcd2-e93c8ea0ceab"
          },
          "name": {
            "type": "string",
            "description": "Meeting name.",
            "example": "Short meeting"
          },
          "description": {
            "type": "string",
            "description": "Optional meeting description; empty when not supplied.",
            "example": "A quick conversation."
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 540,
            "description": "Meeting duration in whole minutes.",
            "example": 15
          },
          "slug": {
            "type": "string",
            "description": "Current unique public address segment.",
            "example": "short-meeting"
          },
          "published": {
            "type": "boolean",
            "description": "True only after a separate publication action.",
            "example": true
          }
        },
        "additionalProperties": {
          "not": {}
        },
        "description": "An administrator-visible offer, including hidden drafts.",
        "example": {
          "id": "29a71c26-c842-407d-bcd2-e93c8ea0ceab",
          "name": "Planning",
          "description": "",
          "durationMinutes": 20,
          "slug": "planning",
          "published": false
        }
      },
      "AdminMeetingTypeList": {
        "type": "object",
        "required": [
          "meetingTypes"
        ],
        "properties": {
          "meetingTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminMeetingType"
            },
            "description": "Published and hidden offers."
          }
        },
        "additionalProperties": {
          "not": {}
        },
        "description": "All meeting types in creation order.",
        "example": {
          "meetingTypes": []
        }
      },
      "AdminSession": {
        "type": "object",
        "required": [
          "username",
          "expiresAt"
        ],
        "properties": {
          "username": {
            "type": "string",
            "description": "Configured administrator username.",
            "example": "owner"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Absolute session expiry, 24 hours after login.",
            "example": "2026-11-14T10:00:00Z"
          }
        },
        "additionalProperties": {
          "not": {}
        },
        "description": "The single administrator's current session. Expiry never slides.",
        "example": {
          "username": "owner",
          "expiresAt": "2026-11-14T10:00:00Z"
        }
      },
      "AuthError": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "description": "Safe explanation of the failure.",
            "example": "Authentication required"
          }
        },
        "additionalProperties": {
          "not": {}
        },
        "description": "An English API error without credentials or private data.",
        "example": {
          "message": "Authentication required"
        }
      },
      "Availability": {
        "type": "object",
        "required": [
          "meetingType",
          "hostName",
          "timeZone",
          "serverNow",
          "today",
          "windowEnd",
          "days"
        ],
        "properties": {
          "meetingType": {
            "allOf": [
              {
                "$ref": "#/components/schemas/MeetingType"
              }
            ],
            "description": "The current published offer.",
            "example": {
              "id": "29a71c26-c842-407d-bcd2-e93c8ea0ceab",
              "name": "Discussion",
              "description": "",
              "durationMinutes": 20,
              "slug": "discussion"
            }
          },
          "hostName": {
            "type": "string",
            "description": "Predetermined public host name, never an email address.",
            "example": "Alex Morgan"
          },
          "timeZone": {
            "type": "string",
            "enum": [
              "Europe/Berlin"
            ],
            "description": "The fixed schedule and display time zone.",
            "example": "Europe/Berlin"
          },
          "serverNow": {
            "type": "string",
            "format": "date-time",
            "description": "Server instant used to calculate this snapshot.",
            "example": "2026-11-13T13:07:00Z"
          },
          "today": {
            "type": "string",
            "format": "date",
            "description": "Today's Berlin date.",
            "example": "2026-11-13"
          },
          "windowEnd": {
            "type": "string",
            "format": "date",
            "description": "Inclusive last Berlin date: today plus thirteen calendar dates.",
            "example": "2026-11-26"
          },
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CalendarDay"
            },
            "description": "All fourteen dates, including weekends.",
            "example": [
              {
                "date": "2026-11-14",
                "workingDay": false,
                "intervals": []
              }
            ]
          }
        },
        "additionalProperties": {
          "not": {}
        },
        "description": "Public calendar snapshot calculated using server time, without guest or occupancy details.",
        "example": {
          "meetingType": {
            "id": "29a71c26-c842-407d-bcd2-e93c8ea0ceab",
            "name": "Discussion",
            "description": "",
            "durationMinutes": 20,
            "slug": "discussion"
          },
          "hostName": "Alex Morgan",
          "timeZone": "Europe/Berlin",
          "serverNow": "2026-11-13T13:07:00Z",
          "today": "2026-11-13",
          "windowEnd": "2026-11-26",
          "days": [
            {
              "date": "2026-11-13",
              "workingDay": true,
              "intervals": [
                {
                  "startsAt": "2026-11-13T13:15:00Z",
                  "endsAt": "2026-11-13T13:35:00Z",
                  "available": true
                }
              ]
            }
          ]
        }
      },
      "CalendarDay": {
        "type": "object",
        "required": [
          "date",
          "workingDay",
          "intervals"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "description": "ISO local date in Europe/Berlin."
          },
          "workingDay": {
            "type": "boolean",
            "description": "Monday through Friday; weekends still count toward the window."
          },
          "intervals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CalendarInterval"
            },
            "description": "Schedule-valid intervals, empty on weekends."
          }
        },
        "additionalProperties": {
          "not": {}
        },
        "description": "A Berlin calendar date in the booking window.",
        "example": {
          "date": "2026-11-14",
          "workingDay": false,
          "intervals": []
        }
      },
      "CalendarInterval": {
        "type": "object",
        "required": [
          "startsAt",
          "endsAt",
          "available"
        ],
        "properties": {
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "description": "Exact start instant on the Berlin quarter-hour grid."
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "description": "Exact end instant, including the full meeting duration."
          },
          "available": {
            "type": "boolean",
            "description": "True only for future intervals without shared occupancy."
          }
        },
        "additionalProperties": {
          "not": {}
        },
        "description": "A schedule-valid interval. Availability is advisory and never reserves time.",
        "example": {
          "startsAt": "2026-11-13T13:15:00Z",
          "endsAt": "2026-11-13T13:35:00Z",
          "available": true
        }
      },
      "Credentials": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "description": "Administrator username.",
            "example": "owner"
          },
          "password": {
            "type": "string",
            "description": "Administrator password.",
            "example": "example-not-a-default-password"
          }
        },
        "additionalProperties": {
          "not": {}
        },
        "description": "Initial credentials are configured by the operator, not public defaults.",
        "example": {
          "username": "owner",
          "password": "example-not-a-default-password"
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "description": "The API process is responding.",
            "example": "ok"
          }
        },
        "additionalProperties": {
          "not": {}
        },
        "description": "API process health; does not imply database readiness.",
        "example": {
          "status": "ok"
        }
      },
      "MeetingType": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "durationMinutes",
          "slug"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Immutable system-assigned identifier.",
            "example": "29a71c26-c842-407d-bcd2-e93c8ea0ceab"
          },
          "name": {
            "type": "string",
            "description": "Meeting name.",
            "example": "Short meeting"
          },
          "description": {
            "type": "string",
            "description": "Optional meeting description; empty when not supplied.",
            "example": "A quick conversation."
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 540,
            "description": "Meeting duration in whole minutes.",
            "example": 15
          },
          "slug": {
            "type": "string",
            "description": "Current unique public address segment.",
            "example": "short-meeting"
          }
        },
        "additionalProperties": {
          "not": {}
        },
        "description": "A published offer available for guest booking.",
        "example": {
          "id": "29a71c26-c842-407d-bcd2-e93c8ea0ceab",
          "name": "Short meeting",
          "description": "A quick conversation.",
          "durationMinutes": 15,
          "slug": "short-meeting"
        }
      },
      "MeetingTypeFieldErrors": {
        "type": "object",
        "properties": {
          "name": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Name errors."
          },
          "description": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Description errors."
          },
          "durationMinutes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Duration errors."
          },
          "slug": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Address errors, including concurrent collisions."
          }
        },
        "additionalProperties": {
          "not": {}
        },
        "description": "English errors keyed by the form's field names.",
        "example": {
          "name": [
            "can't be blank"
          ],
          "description": [
            "is too long (maximum is 2000 characters)"
          ],
          "durationMinutes": [
            "must be a whole number from 1 to 540"
          ],
          "slug": [
            "has already been taken"
          ]
        }
      },
      "MeetingTypeList": {
        "type": "object",
        "required": [
          "meetingTypes"
        ],
        "properties": {
          "meetingTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MeetingType"
            },
            "description": "Published offers, or an empty array when none are available."
          }
        },
        "additionalProperties": {
          "not": {}
        },
        "description": "The available public meeting offers.",
        "example": {
          "meetingTypes": []
        }
      },
      "MeetingTypePublication": {
        "type": "object",
        "required": [
          "published"
        ],
        "properties": {
          "published": {
            "type": "boolean",
            "description": "Publish for new bookings, or hide without changing existing bookings or occupancy."
          }
        },
        "additionalProperties": {
          "not": {}
        },
        "description": "Explicit desired publication state; saving details never changes this state.",
        "example": {
          "published": true
        }
      },
      "MeetingTypeUnavailable": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "enum": [
              "Meeting type unavailable"
            ],
            "description": "Safe public explanation."
          }
        },
        "additionalProperties": {
          "not": {}
        },
        "description": "Indistinguishable response for hidden and nonexistent meeting types.",
        "example": {
          "message": "Meeting type unavailable"
        }
      },
      "NewMeetingType": {
        "type": "object",
        "required": [
          "name",
          "durationMinutes",
          "slug"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "After trimming: 1–100 characters."
          },
          "description": {
            "type": "string",
            "description": "Optional description, at most 2000 characters."
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32",
            "description": "A whole number from 1 to 540, not restricted to a 15-minute multiple."
          },
          "slug": {
            "type": "string",
            "description": "After trimming: 1–80 lowercase Latin letters/digits with single hyphens between nonempty parts. Unique among all offers; never silently renamed."
          }
        },
        "additionalProperties": {
          "not": {}
        },
        "description": "New hidden meeting type. Trim name and address at their edges only. Description consisting only of whitespace becomes empty. Unknown fields cannot assign identity or publication.",
        "example": {
          "name": "Planning",
          "description": "",
          "durationMinutes": 20,
          "slug": "planning"
        }
      }
    },
    "securitySchemes": {
      "AdminCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "calendar_admin",
        "description": "Opaque HttpOnly SameSite=Strict cookie, Secure in production."
      }
    }
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Same-origin API prefix",
      "variables": {}
    }
  ]
}
